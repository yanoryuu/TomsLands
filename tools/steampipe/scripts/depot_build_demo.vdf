"DepotBuild"
{
	"DepotID" "5186791" // 体験版の Windows depot（Steamworks で確認済み）

	"FileMapping"
	{
		"LocalPath" "*"
		"DepotPath" "."
		"recursive" "1"
	}

	// 製品に入れないもの（本編の depot_build_4535811.vdf と同じ）
	"FileExclusion" "*.pdb"
	"FileExclusion" "*_BurstDebugInformation_DoNotShip*"
	"FileExclusion" "*_BackUpThisFolder_ButDontShipItWithYourGame*"
	"FileExclusion" "steam_appid.txt"
}
