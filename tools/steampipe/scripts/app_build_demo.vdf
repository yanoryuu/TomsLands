"AppBuild"
{
	// トコのトムトムランド 体験版（App 5186790）。Assets/Scripts/Demo/DemoBuild.cs の DemoSteamAppId と同じ値にする。
	"AppID" "5186790"
	"Desc" "TomsLands demo build" // 管理画面のビルド一覧に出る説明。上げる前に版（例: demo v1.0）に書き換える
	"verbose" "0"
	"preview" "0" // 1 にすると、アップロードせずに中身の確認だけする
	"SetLive" "" // 空のまま。公開するブランチは Steamworks の管理画面で選ぶ

	"ContentRoot" "D:\UnityGame\TomsShop_Demo\" // Unity の「体験版をビルド」の出力先
	"BuildOutput" "..\output\"

	"Depots"
	{
		"5186791" "depot_build_demo.vdf" // 【要確認】体験版の Windows depot。App ID + 1 と仮定。Steamworks の「SteamPipe > Depots」の番号と違えば直す
	}
}
