"AppBuild"
{
	// 【仮】トコのトムトムランド 体験版。体験版の App はまだ Steamworks で作っていない。
	// 作ったら "0" を体験版の App ID に書き換える（Assets/Scripts/Demo/DemoBuild.cs の DemoSteamAppId も同じ値に）。
	// 0 のままだと run_tomslands_demo_build.bat は止まる（間違って上げないため）。
	"AppID" "0" // 【仮】体験版の App ID
	"Desc" "TomsLands demo build" // 管理画面のビルド一覧に出る説明。上げる前に版（例: demo v1.0）に書き換える
	"verbose" "0"
	"preview" "0" // 1 にすると、アップロードせずに中身の確認だけする
	"SetLive" "" // 空のまま。公開するブランチは Steamworks の管理画面で選ぶ

	"ContentRoot" "D:\UnityGame\TomsShop_Demo\" // Unity の「体験版をビルド」の出力先
	"BuildOutput" "..\output\"

	"Depots"
	{
		"0" "depot_build_demo.vdf" // 【仮】左は体験版の Windows depot の番号（ふつうは体験版の App ID + 1）
	}
}
